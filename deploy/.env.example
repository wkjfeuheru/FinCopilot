# FinHarness 生产配置模板。复制为同目录 .env 后填写：
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# .env 已被 .gitignore 忽略，绝不提交。

# 对外域名（需先在 DNS 把 A 记录指到服务器公网 IP）
DOMAIN=fin.example.com

# ---- LLM Provider 密钥（按使用选填，至少一个）----
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=

# ---- 数据与检索（选填）----
TUSHARE_TOKEN=
TAVILY_API_KEY=
HITHINK_FINANCE_API_KEY=

# ---- 初始化开关 ----
# 首次上线临时改 true 注册管理员账号，注册完改回 false 并
# docker compose up -d 重新生效（见 docs/deploy/aliyun.md 第 6 步）
FINH_AUTH_ALLOW_REGISTER=false

# ---- 内部计算 worker ----
# 至少 16 字节的随机值，例如：openssl rand -hex 32
FINH_COMPUTE_HMAC_SECRET=

# ---- 构建参数（一般不用动）----
# 境外服务器可删掉这一行走官方源：UV_INDEX_URL=https://pypi.org/simple
UV_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
