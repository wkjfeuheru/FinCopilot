.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp*/
.tmp/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
node_modules/
frontend/dist/
*.tsbuildinfo
.env
.env.*
!.env.example
settings.json
data_cache/*
!data_cache/.gitkeep
# Relative default paths resolve against the process working directory when
# Settings is built without a file, so a stray data_cache can appear in any
# subdirectory (e.g. frontend/). Ignore it wherever it lands.
**/data_cache/
# state/ holds the Fernet master key, the user/token database and the encrypted
# provider-config store (docs 03.13). It must never be committed: it is the
# agent-unreachable directory by design (see docs 生产环境隔离与多租户加固方案.md).
state/*
!state/.gitkeep
**/state/
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep
# Evaluation run artefacts (per-run case JSON, traces, reports) are reproducible
# output, not source; keep the case definitions and config tracked.
evals/runs/
.mimosa/
# ZCode IDE session plans and scratch state; not project content.
.zcode/
# Workflow-tool scratch output (task reports, cached runs); not project content.
.superpowers/
.superdesign/tmp/
.workbuddy/
